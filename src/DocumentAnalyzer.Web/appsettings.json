{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "Ollama",
    "Temperature": 0,
    "MaxOutputTokens": 5000,
    "TimeoutMinutes": 30,
    "Ollama": {
      "BaseAddress": "http://localhost:11434",
      "Model": "qwen3:4b",
      "KeepAlive": "30m",
      "NumCtx": 8192
    },
    "OpenAiCompatible": {
      "BaseAddress": "https://api.openai.com/v1/",
      "Model": "",
      "MaxTokensField": "max_tokens",
      "SendTemperature": true
    }
  },
  "Storage": {
    "InputFolder": "../../samples",
    "RequirementsSubfolder": "requirements",
    "DesignsSubfolder": "designs",
    "OutputFolder": "../../output/reports"
  }
}
